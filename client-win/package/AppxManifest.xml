<?xml version="1.0" encoding="utf-8"?>
<!-- A sparse package: it gives Aetheris.exe (installed outside it, in %LOCALAPPDATA%\Programs\Aetheris) a package
     identity, and declares the app a cloud files provider. With that, Explorer ties the sync root to the app and
     shows it in the navigation pane like OneDrive. Registered by scripts/install-client.ps1. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop3="http://schemas.microsoft.com/appx/manifest/desktop/windows10/3"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop3 desktop6 rescap">

  <!-- Publisher must match the msix element in client-win/app.manifest. -->
  <Identity Name="Aetheris.Drive" Publisher="CN=Aetheris" Version="1.0.0.0" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Aetheris</DisplayName>
    <PublisherDisplayName>Aetheris</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
    <!-- The app keeps writing its real files and registry keys, exactly as it does without a package. -->
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26300.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application Id="Aetheris" Executable="Aetheris.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements DisplayName="Aetheris" Description="Your NAS as a cloud folder"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <desktop3:Extension Category="windows.cloudFiles">
          <desktop3:CloudFiles />
        </desktop3:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
